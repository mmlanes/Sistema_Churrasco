# Exemplo de configuração de Secrets para o Streamlit Cloud (App Settings > Secrets)
[supabase]
url = "https://seu-projeto.supabase.co"
key = "sua_chave_anon_ou_publishable_key"
db_password = "sua_senha_do_banco"
db_host = "db.seu-projeto.supabase.co"
db_port = 5432
db_user = "postgres"
db_name = "postgres"
connection_string = "postgresql://postgres:sua_senha@db.seu-projeto.supabase.co:5432/postgres"
